## 🔧 2. TAMBAHAN JAVASCRIPT (Letakkan dalam bahagian `<script>`)

Tambahkan fungsi-fungsi ini selepas fungsi `window.onload` atau di dalamnya:

```javascript
// ============================================================
// SYNC GOOGLE DATA (Simulasi)
// ============================================================
function syncGoogleData() {
    showToast('🔄 Menyegerakkan data Google & repositori...');
    setTimeout(() => {
        document.getElementById('scholarCount').innerText = '2';
        document.getElementById('githubCount').innerText = '3';
        document.getElementById('linkedinCount').innerText = '1';
        document.getElementById('researchgateCount').innerText = '1';
        document.getElementById('googleSyncTime').innerText = new Date().toLocaleString();
        showToast('✅ Data Google & repositori disegerakkan!');
    }, 2000);
}

// ============================================================
// LIVE SERVER TELEMETRY (Simulasi)
// ============================================================
let serverInterval;

function updateServerTelemetry() {
    // Simulasi perubahan kecil
    const uptime = (99.9 + Math.random() * 0.09).toFixed(2);
    document.getElementById('serverUptime').innerText = uptime + '%';
    const cpu = (20 + Math.random() * 15).toFixed(1);
    document.getElementById('cpuLoad').innerText = cpu + '%';
    const ram = (3.8 + Math.random() * 1.0).toFixed(1);
    document.getElementById('ramUsage').innerText = ram + ' GB';
    const req = parseInt(document.getElementById('apiRequests').innerText.replace(',', '')) + Math.floor(Math.random() * 10);
    document.getElementById('apiRequests').innerText = req.toLocaleString();
    document.getElementById('serverTime').innerText = new Date().toLocaleTimeString();
}

// ============================================================
// INIT TAMBAHAN (Panggil dalam window.onload)
// ============================================================
// Tambahkan di dalam window.onload sedia ada:
window.addEventListener('load', function() {
    // ... kod sedia ada ...
    // Panggil sekali
    updateServerTelemetry();
    // Kemaskini setiap 5 saat
    setInterval(updateServerTelemetry, 5000);
    // Set sync time
    document.getElementById('googleSyncTime').innerText = new Date().toLocaleString();
});
```

