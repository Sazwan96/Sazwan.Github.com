// Fungsi untuk mengambil harga crypto secara live dari CoinGecko
async function fetchLiveCryptoPrices() {
    try {
        const response = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,binancecoin&vs_currencies=usd&include_24hr_change=true');
        const data = await response.json();

        // Update BTC
        if(data.bitcoin) {
            document.getElementById('live-btc-price').innerText = `$${data.bitcoin.usd.toLocaleString()}`;
        }
        // Update ETH
        if(data.ethereum) {
            document.getElementById('live-eth-price').innerText = `$${data.ethereum.usd.toLocaleString()}`;
        }
        
        console.log("Harga Crypto berjaya dikemaskini.");
    } catch (error) {
        console.error("Gagal mengambil data API:", error);
    }
}

// Panggil fungsi ini setiap 60 saat (1 minit) supaya harga sentiasa update
setInterval(fetchLiveCryptoPrices, 60000);
// Panggil sekali semasa mula-mula load
document.addEventListener('DOMContentLoaded', fetchLiveCryptoPrices);
