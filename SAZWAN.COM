### 🔹 9. SAMPEL KOD (Key Components)

#### 9.1 Smart Contract (Solidity) untuk Pengesahan
```solidity
pragma solidity ^0.8.0;

contract SGAEVerifier {
    bytes32 public constant MASTER_HASH = 0x32d8a53cc4c299e60424c0d0e96d3b06575d51;

    event Verified(address indexed user, bool status, uint256 timestamp);

    function verifyIdentity(string memory name, string memory ic) public returns (bool) {
        bytes32 computed = keccak256(abi.encodePacked(name, ic));
        bool isValid = (computed == MASTER_HASH);
        emit Verified(msg.sender, isValid, block.timestamp);
        return isValid;
    }
}
```

#### 9.2 Skrip Automasi Pengesahan (Python)
```python
import hashlib

MASTER_HASH = "32D8A53CC4C299E60424C0D0E96D3B06575D51"

def verify_identity(name, ic):
    data = f"{name}{ic}".encode()
    computed = hashlib.sha256(data).hexdigest().upper()
    return computed == MASTER_HASH

# Contoh
print(verify_identity("MUHAMAD SAZWAN BIN ISMAIL", "961022-02-5739"))  # True
```

#### 9.3 API Gateway (Node.js + Express)
```javascript
const express = require('express');
const crypto = require('crypto');
const app = express();
app.use(express.json());

const MASTER_HASH = '32D8A53CC4C299E60424C0D0E96D3B06575D51';

app.post('/v2/verify/certificate', (req, res) => {
  const { certId, data } = req.body;
  const computed = crypto.createHash('sha256').update(JSON.stringify(data)).digest('hex').toUpperCase();
  const verified = (computed === MASTER_HASH);
  res.json({ certId, verified, expected: MASTER_HASH, computed, timestamp: new Date() });
});

app.listen(3000, () => console.log('SGAE Verification API running on port 3000'));
```

